+++ b/tools/echo/gen_species.py
@@ -0,0 +1,411 @@
+#!/usr/bin/env python3
+"""Pokémon Echo: procedurally drawn species sprites + species data (no AI, pure geometry).
+
+Each creature is a list of shaded primitives (ellipses, polygons, capsules). Rendering does
+per-primitive sphere shading with three tones, then pixel-art outlines. Outputs follow the
+pokeemerald-expansion graphics layout, plus generated C data headers.
+Run from the repo root: python3 tools/echo/gen_species.py [--preview out.png]
+"""
+import colorsys, math, os, re, sys
+from PIL import Image
+
+GFX = 'graphics/pokemon/echo'
+BG = (152, 208, 160)
+OUTLINE = (40, 32, 48)
+LIGHT = (-0.45, -0.55, 0.70)
+_l = math.sqrt(sum(c * c for c in LIGHT)); LIGHT = tuple(c / _l for c in LIGHT)
+
+def hexc(h):
+    h = h.lstrip('#'); return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))
+
+def mix(a, b, t):
+    return tuple(round(a[i] + (b[i] - a[i]) * t) for i in range(3))
+
+def shades(base):
+    return [mix(base, (255, 250, 230), 0.38), base, mix(base, (48, 32, 72), 0.42)]
+
+def hue_rot(c, d):
+    h, l, s = colorsys.rgb_to_hls(*(x / 255 for x in c))
+    return tuple(round(x * 255) for x in colorsys.hls_to_rgb((h + d) % 1, l, s))
+
+# ---------------------------------------------------------------- primitives
+def E(cx, cy, rx, ry, mat, ang=0, **kw): return dict(k='e', p=(cx, cy, rx, ry, ang), mat=mat, **kw)
+def P(pts, mat, **kw): return dict(k='p', p=pts, mat=mat, **kw)
+def L(x0, y0, x1, y1, w, mat, **kw): return dict(k='l', p=(x0, y0, x1, y1, w), mat=mat, **kw)
+
+def light_index(u, v, z):
+    d = u * LIGHT[0] + v * LIGHT[1] + z * LIGHT[2]
+    if v > 0.78: return 2
+    return 0 if d > 0.80 else (2 if d < 0.30 else 1)
+
+def inside_poly(x, y, pts):
+    c = False; j = len(pts) - 1
+    for i in range(len(pts)):
+        xi, yi = pts[i]; xj, yj = pts[j]
+        if (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / (yj - yi) + xi: c = not c
+        j = i
+    return c
+
+class Creature:
+    def __init__(self, mats, parts):
+        self.mats = mats          # name -> hex; name ending in '!' is a single flat tone
+        self.parts = parts
+        self.pal = [BG, OUTLINE]; self.mi = {}
+        for name, hx in mats.items():
+            self.mi[name] = len(self.pal)
+            self.pal += [hexc(hx)] if name.endswith('!') else shades(hexc(hx))
+        assert len(self.pal) <= 16, len(self.pal)
+        self.pal += [(0, 0, 0)] * (16 - len(self.pal))
+
+    def shiny_pal(self):
+        out = [BG, OUTLINE]
+        for name, hx in self.mats.items():
+            c = hexc(hx)
+            c = c if name.endswith('!') else hue_rot(c, 0.17)
+            out += [c] if name.endswith('!') else shades(c)
+        return out + [(0, 0, 0)] * (16 - len(out))
+
+    def render(self, ax=1, bx=0, ay=1, by=0, back=False):
+        W = H = 64
+        idx = [[0] * W for _ in range(H)]; part = [[-1] * W for _ in range(H)]; noo = set()
+        for pid, pr in enumerate(self.parts):
+            if back and pr.get('front'): continue
+            if pr.get('nooutline'): noo.add(pid)
+            mat = pr['mat']; k = pr['k']
+            if k == 'e':
+                cx, cy, rx, ry, ang = pr['p']; cx, cy, rx, ry = ax * cx + bx, ay * cy + by, max(rx * ax, .6), max(ry * ay, .6)
+                ca, sa = math.cos(math.radians(ang)), math.sin(math.radians(ang)); R = max(rx, ry) + 1
+                box = (cx - R, cy - R, cx + R, cy + R)
+            elif k == 'p':
+                pts = [(ax * x + bx, ay * y + by) for x, y in pr['p']]
+                xs = [q[0] for q in pts]; ys = [q[1] for q in pts]
+                box = (min(xs), min(ys), max(xs), max(ys))
+                pcx, pcy = (box[0] + box[2]) / 2, (box[1] + box[3]) / 2
+                hw, hh = max((box[2] - box[0]) / 2, 1), max((box[3] - box[1]) / 2, 1)
+            else:
+                x0, y0, x1, y1, w = pr['p']; x0, x1, y0, y1 = ax * x0 + bx, ax * x1 + bx, ay * y0 + by, ay * y1 + by
+                hwid = max(w * ax / 2, 0.6); dx, dy = x1 - x0, y1 - y0; ll = max(dx * dx + dy * dy, 1e-6)
+                box = (min(x0, x1) - hwid - 1, min(y0, y1) - hwid - 1, max(x0, x1) + hwid + 1, max(y0, y1) + hwid + 1)
+            for y in range(max(0, int(box[1]) - 1), min(H, int(box[3]) + 2)):
+                for x in range(max(0, int(box[0]) - 1), min(W, int(box[2]) + 2)):
+                    px, py = x + .5, y + .5
+                    if k == 'e':
+                        dx_, dy_ = px - cx, py - cy
+                        u = (dx_ * ca + dy_ * sa) / rx; v = (-dx_ * sa + dy_ * ca) / ry; r2 = u * u + v * v
+                        if r2 > 1: continue
+                        z = math.sqrt(1 - r2)
+                    elif k == 'p':
+                        if not inside_poly(px, py, pts): continue
+                        u, v, z = (px - pcx) / hw, (py - pcy) / hh, 0.55
+                    else:
+                        t = max(0, min(1, ((px - x0) * dx + (py - y0) * dy) / ll))
+                        qx, qy = x0 + t * dx - px, y0 + t * dy - py
+                        dist = math.sqrt(qx * qx + qy * qy)
+                        if dist > hwid: continue
+                        s = -dist / hwid if qx + qy > 0 else dist / hwid
+                        u, v, z = s * .7, s * .7, math.sqrt(max(0, 1 - s * s))
+                    if mat is None:
+                        idx[y][x] = 0; part[y][x] = -1; continue
+                    if mat == 'outline': c = 1
+                    elif mat.endswith('!'): c = self.mi[mat]
+                    else: c = self.mi[mat] + light_index(u, v, z)
+                    idx[y][x] = c; part[y][x] = pid
+        out = [row[:] for row in idx]
+        for y in range(H):
+            for x in range(W):
+                nb = [(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)]
+                nb = [(a, b) for a, b in nb if 0 <= a < W and 0 <= b < H]
+                if idx[y][x] == 0:
+                    if any(idx[b][a] for a, b in nb): out[y][x] = 1
+                elif part[y][x] not in noo:
+                    me = self.parts[part[y][x]]['mat']
+                    for a, b in nb:
+                        q = part[b][a]
+                        if q > part[y][x] and q not in noo and self.parts[q]['mat'] != me:
+                            out[y][x] = 1; break
+        return out
+
+def bbox(img):
+    ys = [y for y in range(64) if any(img[y])]; xs = [x for x in range(64) if any(img[y][x] for y in range(64))]
+    return min(xs), min(ys), max(xs) + 1, max(ys) + 1
+
+def r8(n): return min(64, (n + 7) // 8 * 8)
+
+def to_png(rows, pal, path):
+    im = Image.new('P', (len(rows[0]), len(rows)))
+    im.putpalette([c for rgb in pal for c in rgb]); im.putdata([v for r in rows for v in r]); im.save(path)
+
+def write_pal(pal, path):
+    with open(path, 'w', newline='\r\n') as f:
+        f.write('JASC-PAL\n0100\n16\n' + ''.join('%d %d %d\n' % c for c in pal))
+
+def load_pal(path):
+    ln = open(path).read().split('\n')[3:19]
+    return [tuple(int(v) for v in l.split()) for l in ln]
+
+ICON_PALS = [load_pal('graphics/pokemon/icon_palettes/pal%d.pal' % i) for i in range(6)]
+
+def make_icon(img, pal):
+    rgb = [[pal[v] if v else None for v in r] for r in img]
+    small = [[None] * 32 for _ in range(32)]
+    for y in range(32):
+        for x in range(32):
+            blk = [rgb[2 * y + j][2 * x + i] for j in (0, 1) for i in (0, 1)]
+            cols = [c for c in blk if c]
+            if len(cols) < 2: continue
+            small[y][x] = OUTLINE if OUTLINE in cols and len(cols) < 4 else max(set(cols), key=cols.count)
+    best = None
+    for pi, ip in enumerate(ICON_PALS):
+        err = 0; rows = []
+        for r in small:
+            row = []
+            for c in r:
+                if c is None: row.append(0); continue
+                j = min(range(1, 16), key=lambda k: sum((c[t] - ip[k][t]) ** 2 for t in range(3)))
+                err += sum((c[t] - ip[j][t]) ** 2 for t in range(3)); row.append(j)
+            rows.append(row)
+        if best is None or err < best[0]: best = (err, pi, rows)
+    _, pi, rows = best
+    rows = [[0] * 32] * 2 + rows[:30]           # sit lower in the 32x32 cell
+    bob = rows[1:] + [[0] * 32]
+    return pi, rows + bob
+
+FOOT = [[0] * 16 for _ in range(16)]
+for (cx, cy, r) in [(8, 10, 3.6), (3.5, 5.5, 1.7), (7, 3.2, 1.7), (11, 3.6, 1.7), (13.5, 6.5, 1.6)]:
+    for y in range(16):
+        for x in range(16):
+            if (x + .5 - cx) ** 2 + (y + .5 - cy) ** 2 <= r * r: FOOT[y][x] = 1
+
+# ---------------------------------------------------------------- creatures
+def tickit():
+    return Creature({'green': '#7cc850', 'brass': '#e0b040', 'metal': '#8c94a8', 'white!': '#f8f8f0'}, [
+        L(38, 40, 50, 28, 5, 'green'), L(50, 28, 47, 56, 4, 'green'), E(46, 57, 4, 2, 'metal'),
+        L(24, 44, 20, 56, 3, 'green'), E(19, 57, 3, 2, 'metal'),
+        E(33, 43, 16, 11, 'green'),
+        E(37, 35, 13, 11, 'brass'), E(37, 35, 8, 7, 'white!'),
+        L(37, 35, 37, 30, 1, 'outline', nooutline=1), L(37, 35, 41, 36, 1, 'outline', nooutline=1),
+        L(29, 46, 27, 57, 3, 'green'), E(26, 58, 3, 2, 'metal'),
+        E(18, 32, 10, 9, 'green'),
+        L(16, 24, 10, 11, 1, 'metal'), L(21, 24, 25, 9, 1, 'metal'), E(10, 10, 2, 2, 'brass'), E(25, 8, 2, 2, 'brass'),
+        E(14, 30, 4, 4.5, 'white!', front=1), E(13, 30.5, 2, 2.6, 'outline', front=1, nooutline=1),
+        E(12.5, 29, .7, .7, 'white!', front=1, nooutline=1),
+        L(10, 37, 14, 38, 1, 'outline', front=1, nooutline=1),
+    ])
+
+def chimell():
+    return Creature({'bronze': '#c88a44', 'psy': '#b874e8', 'dark!': '#3a2c48', 'white!': '#f8f8f0'}, [
+        E(32, 9, 15, 4, 'psy'), E(32, 9, 11, 2, None),
+        E(32, 16, 4, 4, 'bronze'), E(32, 16, 1.8, 1.8, None),
+        E(32, 28, 12, 12, 'bronze'),
+        P([(20, 28), (44, 28), (51, 49), (13, 49)], 'bronze'),
+        E(32, 49, 19, 5, 'bronze'), E(32, 50, 15, 3, 'dark!'),
+        L(18, 42, 46, 42, 2, 'psy'),
+        E(27, 34, 3, 4, 'white!', front=1), E(37, 34, 3, 4, 'white!', front=1),
+        E(27, 35, 1.5, 2.2, 'outline', front=1, nooutline=1), E(37, 35, 1.5, 2.2, 'outline', front=1, nooutline=1),
+        E(32, 56, 4, 4, 'psy'),
+        E(8, 30, 2, 3, 'psy'), E(56, 36, 2, 3, 'psy'), E(52, 20, 1.5, 2, 'psy'),
+    ])
+
+def gloamoth():
+    return Creature({'wing': '#5c3c90', 'spot': '#f09030', 'fur': '#ead8b0', 'white!': '#f8f8f0'}, [
+        P([(34, 30), (60, 8), (63, 36), (44, 44)], 'wing'), P([(36, 40), (57, 44), (51, 59), (38, 50)], 'wing'),
+        E(52, 23, 4, 4, 'spot'),
+        E(32, 39, 7, 14, 'fur'),
+        P([(29, 30), (4, 6), (1, 36), (20, 44)], 'wing'), E(12, 25, 5.5, 5.5, 'spot'), E(12, 25, 2, 2, 'outline', nooutline=1),
+        P([(28, 40), (7, 44), (13, 59), (26, 50)], 'wing'), E(16, 49, 3, 3, 'spot'),
+        E(32, 28, 9, 4, 'fur'), E(32, 21, 7, 6, 'fur'),
+        L(29, 16, 21, 5, 2, 'fur'), L(35, 16, 43, 5, 2, 'fur'),
+        E(28.5, 20, 2.5, 3, 'white!', front=1), E(35.5, 20, 2.5, 3, 'white!', front=1),
+        E(28.5, 20.5, 1.4, 1.8, 'outline', front=1, nooutline=1), E(35.5, 20.5, 1.4, 1.8, 'outline', front=1, nooutline=1),
+    ])
+
+def tidepup():
+    return Creature({'blue': '#74b4ec', 'belly': '#eef2fa', 'flip': '#4a7cc4', 'white!': '#ffffff'}, [
+        E(54, 52, 7, 3, 'flip', ang=-25),
+        E(35, 43, 20, 14, 'blue'), E(29, 49, 12, 8, 'belly'),
+        E(21, 30, 13, 12, 'blue'), E(15, 35, 6.5, 4.5, 'belly'),
+        E(23, 17, 3, 4, 'blue'),
+        E(12, 33, 2, 1.5, 'outline', front=1, nooutline=1),
+        E(17, 27, 2.6, 3.2, 'outline', front=1, nooutline=1), E(16.3, 26, .8, .8, 'white!', front=1, nooutline=1),
+        E(25, 27, 2.4, 3, 'outline', front=1, nooutline=1), E(24.3, 26, .8, .8, 'white!', front=1, nooutline=1),
+        L(9, 36, 4, 35, 1, 'outline', front=1, nooutline=1), L(9, 38, 4, 40, 1, 'outline', front=1, nooutline=1),
+        E(27, 55, 7, 3, 'flip', ang=15),
+    ])
+
+def bramblit():
+    spikes = []
