diff --git a/data/maps/VerranBellmoor_BellHall/scripts.inc b/data/maps/VerranBellmoor_BellHall/scripts.inc
new file mode 100644
index 00000000..f0f20e41
--- /dev/null
+++ b/data/maps/VerranBellmoor_BellHall/scripts.inc
@@ -0,0 +1,39 @@
+VerranBellmoor_BellHall_MapScripts::
+	map_script MAP_SCRIPT_ON_TRANSITION, VerranBellmoor_BellHall_OnTransition
+	.byte 0
+
+VerranBellmoor_BellHall_OnTransition:
+	special EchoLoop_BufferDayTime
+	setflag FLAG_ECHO_HIDE_ODETTE_HALL
+	call_if_eq VAR_0x8001, 2, VerranBellmoor_BellHall_EventScript_Show
+	end
+
+VerranBellmoor_BellHall_EventScript_Show::
+	clearflag FLAG_ECHO_HIDE_ODETTE_HALL
+	return
+
+VerranBellmoor_BellHall_EventScript_Odette::
+	lock
+	faceplayer
+	msgbox VerranBellmoor_BellHall_Text_Odette, MSGBOX_DEFAULT
+	setvar VAR_0x8004, 2
+	call EventScript_EchoNote
+	release
+	end
+
+VerranBellmoor_BellHall_EventScript_Archivist::
+	msgbox VerranBellmoor_BellHall_Text_Archivist, MSGBOX_NPC
+	end
+
+VerranBellmoor_BellHall_Text_Odette:
+	.string "ODETTE: Each dusk I read his last\n"
+	.string "letter here. “Back before the bell.”\p"
+	.string "On the third night I'll ring it so\n"
+	.string "loud the whole sea hears.$"
+
+VerranBellmoor_BellHall_Text_Archivist:
+	.string "The Great Bell was cast from a fallen\n"
+	.string "star. A CHIMELL sleeps inside it.\p"
+	.string "Old records say a bell rung in grief\n"
+	.string "can fold time back on itself…\p"
+	.string "Superstition, surely. Ha ha.$"
