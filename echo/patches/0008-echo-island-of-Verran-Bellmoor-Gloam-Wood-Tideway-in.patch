+VerranBellmoor_OdetteHouse_MapScripts::
+	map_script MAP_SCRIPT_ON_TRANSITION, VerranBellmoor_OdetteHouse_OnTransition
+	.byte 0
+
+VerranBellmoor_OdetteHouse_OnTransition:
+	special EchoLoop_BufferDayTime
+	setflag FLAG_ECHO_HIDE_ODETTE_HOME
+	call_if_le VAR_0x8001, 1, VerranBellmoor_OdetteHouse_EventScript_Show
+	goto_if_ne VAR_0x8001, 3, VerranBellmoor_OdetteHouse_EventScript_Done
+	call_if_le VAR_0x8000, 1, VerranBellmoor_OdetteHouse_EventScript_Show
+VerranBellmoor_OdetteHouse_EventScript_Done:
+	end
+
+VerranBellmoor_OdetteHouse_EventScript_Show::
+	clearflag FLAG_ECHO_HIDE_ODETTE_HOME
+	return
+
+VerranBellmoor_OdetteHouse_EventScript_Odette::
+	lock
+	faceplayer
+	goto_if_set FLAG_ECHO_GAVE_COMPASS, VerranBellmoor_OdetteHouse_EventScript_After
+	goto_if_set FLAG_ECHO_HAS_COMPASS, VerranBellmoor_OdetteHouse_EventScript_Give
+	msgbox VerranBellmoor_OdetteHouse_Text_Ritual, MSGBOX_DEFAULT
+	setvar VAR_0x8004, 2
+	call EventScript_EchoNote
+	release
+	end
+
+VerranBellmoor_OdetteHouse_EventScript_Give::
+	msgbox VerranBellmoor_OdetteHouse_Text_Give, MSGBOX_DEFAULT
+	setflag FLAG_ECHO_GAVE_COMPASS
+	clearflag FLAG_ECHO_HAS_COMPASS
+	setvar VAR_0x8004, 9
+	call EventScript_EchoNote
+	release
+	end
+
+VerranBellmoor_OdetteHouse_EventScript_After::
+	msgbox VerranBellmoor_OdetteHouse_Text_After, MSGBOX_DEFAULT
+	release
+	end
+
+VerranBellmoor_OdetteHouse_Text_Ritual:
+	.string "ODETTE: The Great Bell was cast to\n"
+	.string "call lost ships home through fog.\p"
+	.string "On the third night, I ring it with\n"
+	.string "all my strength. For my brother.\p"
+	.string "Maybe this time CORIN hears it.$"
+
+VerranBellmoor_OdetteHouse_Text_Give:
+	.string "ODETTE: That compass… CORIN!\n"
+	.string "Where did you… The shore? Truly?\p"
+	.string "…Ten years I've rung that bell,\n"
+	.string "begging the sea to give him back.\p"
+	.string "And it did. Just not how I hoped.\p"
+	.string "On the third night I'll go to the bell.\n"
+	.string "Not to call him. To let him go.$"
+
+VerranBellmoor_OdetteHouse_Text_After:
+	.string "ODETTE: Third night, at the bell.\n"
+	.string "Will you come with me?$"
