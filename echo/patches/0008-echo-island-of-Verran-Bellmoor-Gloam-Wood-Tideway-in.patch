diff --git a/data/maps/VerranBellmoor/scripts.inc b/data/maps/VerranBellmoor/scripts.inc
new file mode 100644
index 00000000..7e1e5d4e
--- /dev/null
+++ b/data/maps/VerranBellmoor/scripts.inc
@@ -0,0 +1,81 @@
+VerranBellmoor_MapScripts::
+	map_script MAP_SCRIPT_ON_FRAME_TABLE, VerranBellmoor_OnFrame
+	.byte 0
+
+VerranBellmoor_OnFrame:
+	map_script_2 VAR_ECHO_INTRO, 0, VerranBellmoor_EventScript_Intro
+	.2byte 0
+
+VerranBellmoor_EventScript_Intro::
+	lockall
+	setvar VAR_ECHO_INTRO, 1
+	goto_if_ne VAR_ECHO_LOOP, 1, VerranBellmoor_EventScript_IntroEnd
+	msgbox VerranBellmoor_Text_Intro, MSGBOX_DEFAULT
+VerranBellmoor_EventScript_IntroEnd:
+	releaseall
+	end
+
+VerranBellmoor_EventScript_Mira::
+	lock
+	faceplayer
+	goto_if_set FLAG_ECHO_GOT_BALLS, VerranBellmoor_EventScript_MiraAfter
+	msgbox VerranBellmoor_Text_MiraGive, MSGBOX_DEFAULT
+	giveitem ITEM_POKE_BALL, 3
+	setflag FLAG_ECHO_GOT_BALLS
+	release
+	end
+
+VerranBellmoor_EventScript_MiraAfter::
+	msgbox VerranBellmoor_Text_MiraAfter, MSGBOX_DEFAULT
+	release
+	end
+
+VerranBellmoor_EventScript_Elder::
+	msgbox VerranBellmoor_Text_Elder, MSGBOX_NPC
+	end
+
+VerranBellmoor_EventScript_Boy::
+	lock
+	faceplayer
+	msgbox VerranBellmoor_Text_Boy, MSGBOX_DEFAULT
+	setvar VAR_0x8004, 8
+	call EventScript_EchoNote
+	release
+	end
+
+VerranBellmoor_EventScript_Sign::
+	msgbox VerranBellmoor_Text_Sign, MSGBOX_SIGN
+	end
+
+VerranBellmoor_Text_Intro:
+	.string "VERRAN ISLAND.\n"
+	.string "The festival of the Great Bell.\p"
+	.string "Your partner TICKIT ticks softly\n"
+	.string "on your shoulder, like a clock.\p"
+	.string "Somewhere north, in GLOAM WOOD,\n"
+	.string "the old bell waits for the third night.$"
+
+VerranBellmoor_Text_MiraGive:
+	.string "MIRA: You're new! Here, festival gift.\n"
+	.string "Wild ones here don't hide in grass.\p"
+	.string "You can see them coming. Pick your\n"
+	.string "fights, and time your moves!$"
+
+VerranBellmoor_Text_MiraAfter:
+	.string "MIRA: Press A when the marker hits\n"
+	.string "the middle. Attacking AND defending!$"
+
+VerranBellmoor_Text_Elder:
+	.string "Every change of light, the bell tolls.\n"
+	.string "Dawn, day, dusk, night.\p"
+	.string "Old ODETTE keeps it. Three days of\n"
+	.string "festival, then she rings it herself.$"
+
+VerranBellmoor_Text_Boy:
+	.string "There's a fox in GLOAM WOOD at dawn.\n"
+	.string "Fire one day, water the next, then\l"
+	.string "spooky! Same fox, I swear!$"
+
+VerranBellmoor_Text_Sign:
+	.string "BELLMOOR\n"
+	.string "“Where every hour is called home.”$"
