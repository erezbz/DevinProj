diff --git a/data/maps/VerranGloamWood/scripts.inc b/data/maps/VerranGloamWood/scripts.inc
new file mode 100644
index 00000000..9dda0ca9
--- /dev/null
+++ b/data/maps/VerranGloamWood/scripts.inc
@@ -0,0 +1,173 @@
+VerranGloamWood_MapScripts::
+	map_script MAP_SCRIPT_ON_TRANSITION, VerranGloamWood_OnTransition
+	.byte 0
+
+VerranGloamWood_OnTransition:
+	special EchoLoop_BufferDayTime
+	setflag FLAG_ECHO_HIDE_SOLUNE
+	setflag FLAG_ECHO_HIDE_GLOAMOTH
+	setflag FLAG_ECHO_HIDE_ODETTE_SHRINE
+	call_if_eq VAR_ECHO_PHASE, 11, VerranGloamWood_EventScript_ShowOdette
+	call_if_unset FLAG_ECHO_SOLUNE_DONE, VerranGloamWood_EventScript_TrySolune
+	call_if_unset FLAG_ECHO_GLOAMOTH_DONE, VerranGloamWood_EventScript_TryGloamoth
+	end
+
+VerranGloamWood_EventScript_ShowOdette::
+	clearflag FLAG_ECHO_HIDE_ODETTE_SHRINE
+	return
+
+VerranGloamWood_EventScript_TrySolune::
+	call_if_eq VAR_0x8001, 0, VerranGloamWood_EventScript_ShowSolune
+	return
+
+VerranGloamWood_EventScript_ShowSolune::
+	clearflag FLAG_ECHO_HIDE_SOLUNE
+	return
+
+VerranGloamWood_EventScript_TryGloamoth::
+	call_if_ge VAR_0x8001, 2, VerranGloamWood_EventScript_ShowGloamoth
+	return
+
+VerranGloamWood_EventScript_ShowGloamoth::
+	clearflag FLAG_ECHO_HIDE_GLOAMOTH
+	return
+
+VerranGloamWood_EventScript_Kit::
+	trainerbattle_single TRAINER_ECHO_KIT, VerranGloamWood_Text_KitIntro, VerranGloamWood_Text_KitDefeat, VerranGloamWood_EventScript_KitShard
+	msgbox VerranGloamWood_Text_KitAfter, MSGBOX_AUTOCLOSE
+	end
+
+VerranGloamWood_EventScript_KitShard::
+	setvar VAR_0x8004, 6
+	call EventScript_EchoShard
+	msgbox VerranGloamWood_Text_KitAfter, MSGBOX_DEFAULT
+	release
+	end
+
+VerranGloamWood_EventScript_Solune::
+	lock
+	faceplayer
+	special EchoLoop_BufferDayTime
+	setvar VAR_0x8004, 8
+	call EventScript_EchoNote
+	playmoncry SPECIES_SOLUNE, CRY_MODE_ENCOUNTER
+	waitmoncry
+	goto_if_eq VAR_0x8000, 1, VerranGloamWood_EventScript_SoluneTide
+	goto_if_eq VAR_0x8000, 2, VerranGloamWood_EventScript_SoluneDusk
+	setwildbattle SPECIES_SOLUNE, 13
+	goto VerranGloamWood_EventScript_SoluneBattle
+VerranGloamWood_EventScript_SoluneTide:
+	setwildbattle SPECIES_SOLUNE_TIDE, 13
+	goto VerranGloamWood_EventScript_SoluneBattle
+VerranGloamWood_EventScript_SoluneDusk:
+	setwildbattle SPECIES_SOLUNE_DUSK, 13
+VerranGloamWood_EventScript_SoluneBattle:
+	setflag FLAG_SYS_CTRL_OBJ_DELETE
+	dowildbattle
+	clearflag FLAG_SYS_CTRL_OBJ_DELETE
+	setflag FLAG_ECHO_SOLUNE_DONE
+	setflag FLAG_ECHO_HIDE_SOLUNE
+	removeobject LOCALID_GLOAM_SOLUNE
+	release
+	end
+
+VerranGloamWood_EventScript_Gloamoth::
+	lock
+	faceplayer
+	playmoncry SPECIES_GLOAMOTH, CRY_MODE_ENCOUNTER
+	waitmoncry
+	setwildbattle SPECIES_GLOAMOTH, 16
+	setflag FLAG_SYS_CTRL_OBJ_DELETE
+	dowildbattle
+	clearflag FLAG_SYS_CTRL_OBJ_DELETE
+	specialvar VAR_RESULT, GetBattleOutcome
+	setflag FLAG_ECHO_GLOAMOTH_DONE
+	setflag FLAG_ECHO_HIDE_GLOAMOTH
+	removeobject LOCALID_GLOAM_GLOAMOTH
+	goto_if_eq VAR_RESULT, B_OUTCOME_RAN, VerranGloamWood_EventScript_GloamothEnd
+	setvar VAR_0x8004, 7
+	call EventScript_EchoShard
+VerranGloamWood_EventScript_GloamothEnd:
+	release
+	end
+
+VerranGloamWood_EventScript_Bell::
+	msgbox VerranGloamWood_Text_Bell, MSGBOX_SIGN
+	end
+
+VerranGloamWood_EventScript_Odette::
+	lock
+	faceplayer
+	goto_if_set FLAG_ECHO_GAVE_COMPASS, VerranGloamWood_EventScript_Farewell
+	msgbox VerranGloamWood_Text_OdetteRing, MSGBOX_DEFAULT
+	setvar VAR_0x8004, 2
+	call EventScript_EchoNote
+	closemessage
+	goto EventScript_EchoLoopEnd
+
+VerranGloamWood_EventScript_Farewell::
+	msgbox VerranGloamWood_Text_Farewell, MSGBOX_DEFAULT
+	playse SE_ORB
+	waitse
+	playmoncry SPECIES_CHIMELL, CRY_MODE_ENCOUNTER
+	msgbox VerranGloamWood_Text_TollWakes, MSGBOX_DEFAULT
+	waitmoncry
+	setwildbattle SPECIES_CHIMELL, 22
+	dowildbattle
+	specialvar VAR_RESULT, GetBattleOutcome
+	goto_if_eq VAR_RESULT, B_OUTCOME_WON, VerranGloamWood_EventScript_Freed
+	goto_if_eq VAR_RESULT, B_OUTCOME_CAUGHT, VerranGloamWood_EventScript_Freed
+	msgbox VerranGloamWood_Text_TollHolds, MSGBOX_DEFAULT
+	release
+	end
+
+VerranGloamWood_EventScript_Freed::
+	special EchoLoop_Break
+	playfanfare MUS_OBTAIN_ITEM
+	msgbox VerranGloamWood_Text_Freed, MSGBOX_DEFAULT
+	waitfanfare
+	release
+	end
+
+VerranGloamWood_Text_KitIntro:
+	.string "KIT: No grinding on Verran! Just\n"
+	.string "your timing against mine. Go!$"
+
+VerranGloamWood_Text_KitDefeat:
+	.string "KIT: Your timing's unreal!$"
+
+VerranGloamWood_Text_KitAfter:
+	.string "KIT: Watch what a foe plans to do,\n"
+	.string "then pick the move that answers it.$"
+
+VerranGloamWood_Text_Bell:
+	.string "THE GREAT BELL OF VERRAN\n"
+	.string "Cast to call lost ships home.$"
+
+VerranGloamWood_Text_OdetteRing:
+	.string "ODETTE: Ring, bell… Bring him home!\n"
+	.string "CORIN, can you hear me?$"
+
+VerranGloamWood_Text_Farewell:
+	.string "ODETTE: You came. Thank you.\p"
+	.string "CORIN… I'm done calling you back.\n"
+	.string "Rest now.\p"
+	.string "She touches the bell, but does not\n"
+	.string "ring it. The bell shudders anyway…$"
+
+VerranGloamWood_Text_TollWakes:
+	.string "The CHIMELL inside the bell wakes,\n"
+	.string "clinging to ten years of grief!$"
+
+VerranGloamWood_Text_TollHolds:
+	.string "The bell's hum grows louder…\n"
+	.string "Time won't let go. Not yet.$"
+
+VerranGloamWood_Text_Freed:
+	.string "The CHIMELL rings one last, soft note\n"
+	.string "and drifts into the night sky.\p"
+	.string "The bell is silent.\p"
+	.string "…And for the first time,\n"
+	.string "a fourth morning dawns on Verran.\p"
+	.string "THE LOOP IS BROKEN.\n"
+	.string "Thanks for playing this slice!$"
