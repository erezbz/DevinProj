diff --git a/tools/echo/gen_maps.py b/tools/echo/gen_maps.py
new file mode 100644
index 00000000..ad8705a4
--- /dev/null
+++ b/tools/echo/gen_maps.py
@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""Pokémon Echo: island of Verran map layouts, authored as carved terrain + building stamps.
+
+Run from repo root: python3 tools/echo/gen_maps.py [--preview DIR]
+Writes data/layouts/<Map>/{map,border}.bin and registers layouts in layouts.json.
+"""
+import json, os, struct, sys
+
+GRASS, TALL, FLOWER = 0x3001, 0x300D, 0x3004
+TREE = ((0x05D4, 0x05D5), (0x05DC, 0x05DD))
+TREE_EDGE = (0x05E4, 0x05E5)          # bottom half of a tree with open ground below
+PATH = ((0x31D0, 0x31D1, 0x31D2), (0x31D8, 0x31D9, 0x31DA), (0x31E0, 0x31E1, 0x31E2))
+SIGN = 0x3403
+STAMPS = {
+    'houseA': [[0x3208, 0x3209, 0x3209, 0x3209, 0x320A], [0x0610, 0x0611, 0x0611, 0x0611, 0x0612],
+               [0x0618, 0x0619, 0x0619, 0x0619, 0x061A], [0x0622, 0x0632, 0x0630, 0x0640, 0x0621],
+               [0x062A, 0x063A, 0x0638, 0x0648, 0x0629]],
+    'houseB': [[0x3208, 0x3209, 0x3209, 0x3209, 0x320A], [0x0610, 0x0611, 0x0611, 0x0611, 0x0612],
+               [0x0618, 0x0619, 0x0619, 0x0619, 0x061A], [0x0620, 0x0640, 0x0631, 0x0632, 0x0623],
+               [0x0628, 0x0648, 0x0639, 0x063A, 0x062B]],
+    'hall':   [[0x320C, 0x3242, 0x3243, 0x320D, 0x320D, 0x320D, 0x320E], [0x0614, 0x064A, 0x064B, 0x0615, 0x0615, 0x0615, 0x0616],
+               [0x0614, 0x0615, 0x0615, 0x0615, 0x0615, 0x0615, 0x0616], [0x061E, 0x060F, 0x060F, 0x062C, 0x0641, 0x062D, 0x061F],
+               [0x0626, 0x0617, 0x0617, 0x0634, 0x0649, 0x0635, 0x0627]],
+}
+DOORS = {'houseA': (3, 4), 'houseB': (1, 4), 'hall': (4, 4)}
+
+
+class Map:
+    def __init__(self, name, w, h):
+        self.name, self.w, self.h = name, w, h
+        self.cells = [['T'] * w for _ in range(h)]
+        self.stamps = []
+        self.raw = {}
+
+    def rect(self, x0, y0, x1, y1, ch):
+        for y in range(y0, y1 + 1):
+            for x in range(x0, x1 + 1):
+                self.cells[y][x] = ch
+        return self
+
+    def put(self, pts, ch):
+        for x, y in pts:
+            self.cells[y][x] = ch
+        return self
+
+    def stamp(self, kind, x, y):
+        self.stamps.append((kind, x, y))
+        dx, dy = DOORS[kind]
+        return (x + dx, y + dy)
+
+    def at(self, x, y):
+        if 0 <= x < self.w and 0 <= y < self.h:
+            return self.cells[y][x]
+        return None
+
+    def block(self, x, y):
+        c = self.cells[y][x]
+        if c == 'T':
+            half = TREE[y % 2][x % 2]
+            below = self.at(x, y + 1)
+            if y % 2 == 1 and below not in ('T', None):
+                return TREE_EDGE[x % 2]
+            return half
+        if c == '.': return GRASS
+        if c == ',': return TALL
+        if c == 'f': return FLOWER
+        if c == 's': return SIGN
+        if c == 'p':
+            same = lambda xx, yy: self.at(xx, yy) in ('p', None)
+            r = 0 if not same(x, y - 1) else 2 if not same(x, y + 1) else 1
+            q = 0 if not same(x - 1, y) else 2 if not same(x + 1, y) else 1
+            return PATH[r][q]
+        if c == 'w':
+            same = lambda xx, yy: self.at(xx, yy) == 'w'
+            top = not same(x, y - 1)
+            if not same(x - 1, y): return 0x10B0 if top else 0x10B8
+            if not same(x + 1, y): return 0x10B2 if top else 0x10BA
+            return 0x10B1 if top else 0x10A1
+        raise ValueError(c)
+
+    def blocks(self):
+        out = [[self.block(x, y) for x in range(self.w)] for y in range(self.h)]
+        for kind, sx, sy in self.stamps:
+            for j, row in enumerate(STAMPS[kind]):
+                for i, v in enumerate(row):
+                    out[sy + j][sx + i] = v
+        for (x, y), v in self.raw.items():
+            out[y][x] = v
+        return out
+
+
+def bellmoor():
+    m = Map('VerranBellmoor', 24, 20)
+    m.rect(2, 2, 21, 17, '.').rect(10, 0, 11, 19, 'p').rect(6, 8, 17, 9, 'p').rect(12, 16, 19, 17, 'p')
+    m.put([(3, 9), (20, 9), (4, 11), (5, 11), (18, 11), (19, 11), (3, 17), (4, 17), (20, 3)], 'f')
+    m.doors = {'odette': m.stamp('houseA', 3, 3), 'tobin': m.stamp('houseB', 15, 3), 'hall': m.stamp('hall', 13, 11)}
+    m.raw[(8, 15)] = SIGN
+    return m
+
+
+def gloamwood():
+    m = Map('VerranGloamWood', 24, 30)
+    for r in [(6, 2, 17, 7), (14, 8, 19, 15), (2, 10, 19, 15), (2, 14, 13, 23), (8, 18, 13, 29), (12, 22, 19, 27)]:
+        m.rect(*r, '.')
+    m.rect(6, 14, 9, 17, ',').rect(14, 22, 19, 25, ',').rect(18, 10, 19, 11, ',')
+    for r in [(16, 8, 17, 11), (4, 12, 17, 13), (4, 14, 5, 19), (4, 20, 11, 21), (10, 22, 11, 29)]:
+        m.rect(*r, 'p')
+    m.put([(9, 4), (10, 4), (13, 4), (14, 4), (7, 6), (16, 6)], 'f')
+    m.raw[(11, 3)] = SIGN
+    return m
+
+
+def tideway():
+    m = Map('VerranTideway', 24, 24)
+    m.rect(8, 0, 13, 5, '.').rect(2, 6, 21, 21, '.').rect(2, 16, 13, 21, 'w')
+    m.rect(10, 0, 11, 15, 'p').rect(12, 12, 19, 13, 'p').rect(14, 6, 19, 9, ',')
+    m.put([(3, 7), (4, 7), (20, 15), (19, 19), (20, 19), (16, 17)], 'f')
+    return m
+
+
+MAPS = [bellmoor, gloamwood, tideway]
+
+
+def write(m):
+    d = f'data/layouts/{m.name}'
+    os.makedirs(d, exist_ok=True)
+    b = m.blocks()
+    open(f'{d}/map.bin', 'wb').write(b''.join(struct.pack('<H', v) for row in b for v in row))
+    open(f'{d}/border.bin', 'wb').write(struct.pack('<4H', 0x1D4, 0x1D5, 0x1DC, 0x1DD))
+    path = 'data/layouts/layouts.json'
+    j = json.load(open(path))
+    lid = 'LAYOUT_' + ''.join('_' + c if c.isupper() else c.upper() for c in m.name).lstrip('_')
+    j['layouts'] = [l for l in j['layouts'] if l.get('id') != lid]
+    j['layouts'].append({'id': lid, 'name': m.name + '_Layout', 'width': m.w, 'height': m.h,
+                         'primary_tileset': 'gTileset_General', 'secondary_tileset': 'gTileset_Petalburg',
+                         'border_filepath': f'{d}/border.bin', 'blockdata_filepath': f'{d}/map.bin',
+                         'layout_version': 'emerald'})
+    json.dump(j, open(path, 'w'), indent=2)
+    open(path, 'a').write('\n')
+    return lid
+
+
+if __name__ == '__main__':
+    built = [f() for f in MAPS]
+    for m in built:
+        print(m.name, write(m), getattr(m, 'doors', ''))
+    if '--preview' in sys.argv:
+        sys.path.insert(0, 'tools/echo')
+        from mapkit import Tileset, render_map
+        ts = Tileset('data/tilesets/primary/general', 'data/tilesets/secondary/petalburg')
+        out = sys.argv[sys.argv.index('--preview') + 1]
+        for m in built:
+            render_map(ts, f'data/layouts/{m.name}/map.bin', m.w, m.h, f'{out}/{m.name}.png')
