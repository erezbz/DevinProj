+#!/usr/bin/env python3
+"""Pokémon Echo: island of Verran map headers/events + map group and map section registration."""
+import json, os
+
+def obj(gfx, x, y, script, flag='0', move='MOVEMENT_TYPE_FACE_DOWN', local_id=None, trainer=False, sight=0, elev=3):
+    o = {'graphics_id': 'OBJ_EVENT_GFX_' + gfx, 'x': x, 'y': y, 'elevation': elev, 'movement_type': move,
+         'movement_range_x': 1, 'movement_range_y': 1,
+         'trainer_type': 'TRAINER_TYPE_NORMAL' if trainer else 'TRAINER_TYPE_NONE',
+         'trainer_sight_or_berry_tree_id': str(sight), 'script': script, 'flag': flag}
+    if local_id: o = {'local_id': local_id, **o}
+    return o
+
+def warp(x, y, dest, wid):
+    return {'x': x, 'y': y, 'elevation': 0, 'dest_map': dest, 'dest_warp_id': str(wid)}
+
+def sign(x, y, script):
+    return {'type': 'sign', 'x': x, 'y': y, 'elevation': 0, 'player_facing_dir': 'BG_EVENT_PLAYER_FACING_ANY', 'script': script}
+
+def conn(m, d):
+    return {'map': m, 'offset': 0, 'direction': d}
+
+B, G, T = 'VerranBellmoor', 'VerranGloamWood', 'VerranTideway'
+MAPS = {
+    B: dict(id='MAP_VERRAN_BELLMOOR', layout='LAYOUT_VERRAN_BELLMOOR', music='MUS_DEWFORD', mapsec='MAPSEC_BELLMOOR',
+            type='MAP_TYPE_TOWN', weather='WEATHER_SUNNY', connections=[conn('MAP_VERRAN_GLOAM_WOOD', 'up'), conn('MAP_VERRAN_TIDEWAY', 'down')],
+            objects=[obj('GIRL_2', 14, 11, f'{B}_EventScript_Mira', move='MOVEMENT_TYPE_LOOK_AROUND'),
+                     obj('GENTLEMAN', 19, 13, f'{B}_EventScript_Elder', move='MOVEMENT_TYPE_WANDER_AROUND'),
+                     obj('BOY_1', 4, 13, f'{B}_EventScript_Boy', move='MOVEMENT_TYPE_WANDER_AROUND')],
+            warps=[warp(6, 7, 'MAP_VERRAN_BELLMOOR_ODETTE_HOUSE', 0), warp(16, 7, 'MAP_VERRAN_BELLMOOR_TOBIN_HOUSE', 0),
+                   warp(17, 15, 'MAP_VERRAN_BELLMOOR_BELL_HALL', 0)],
+            bg=[sign(8, 15, f'{B}_EventScript_Sign')]),
+    G: dict(id='MAP_VERRAN_GLOAM_WOOD', layout='LAYOUT_VERRAN_GLOAM_WOOD', music='MUS_PETALBURG_WOODS', mapsec='MAPSEC_GLOAM_WOOD',
+            type='MAP_TYPE_ROUTE', weather='WEATHER_SHADE', connections=[conn('MAP_VERRAN_BELLMOOR', 'down')],
+            objects=[obj('BUG_CATCHER', 5, 14, f'{G}_EventScript_Kit', trainer=True, sight=4),
+                     obj('POOCHYENA', 13, 4, f'{G}_EventScript_Solune', 'FLAG_ECHO_HIDE_SOLUNE', 'MOVEMENT_TYPE_LOOK_AROUND', 'LOCALID_GLOAM_SOLUNE'),
+                     obj('SKITTY', 16, 23, f'{G}_EventScript_Gloamoth', 'FLAG_ECHO_HIDE_GLOAMOTH', 'MOVEMENT_TYPE_WANDER_AROUND', 'LOCALID_GLOAM_GLOAMOTH'),
+                     obj('OLD_WOMAN', 11, 5, f'{G}_EventScript_Odette', 'FLAG_ECHO_HIDE_ODETTE_SHRINE', 'MOVEMENT_TYPE_FACE_UP', 'LOCALID_GLOAM_ODETTE')],
+            warps=[], bg=[sign(11, 3, f'{G}_EventScript_Bell')]),
+    T: dict(id='MAP_VERRAN_TIDEWAY', layout='LAYOUT_VERRAN_TIDEWAY', music='MUS_ROUTE104', mapsec='MAPSEC_TIDEWAY',
+            type='MAP_TYPE_ROUTE', weather='WEATHER_SUNNY', connections=[conn('MAP_VERRAN_BELLMOOR', 'up')],
+            objects=[obj('FISHERMAN', 8, 15, f'{T}_EventScript_Tobin', 'FLAG_ECHO_HIDE_TOBIN_SHORE'),
+                     obj('ITEM_BALL', 3, 15, f'{T}_EventScript_Compass', 'FLAG_ECHO_HIDE_COMPASS', local_id='LOCALID_TIDEWAY_COMPASS'),
+                     obj('ZIGZAGOON_1', 17, 17, f'{T}_EventScript_Tidepup', 'FLAG_ECHO_HIDE_TIDEPUP', 'MOVEMENT_TYPE_WANDER_AROUND', 'LOCALID_TIDEWAY_TIDEPUP'),
+                     obj('SAILOR', 16, 8, f'{T}_EventScript_Sailor', move='MOVEMENT_TYPE_FACE_LEFT')],
+            warps=[], bg=[]),
+    B + '_OdetteHouse': dict(id='MAP_VERRAN_BELLMOOR_ODETTE_HOUSE', layout='LAYOUT_HOUSE1', music='MUS_DEWFORD', mapsec='MAPSEC_BELLMOOR',
+            type='MAP_TYPE_INDOOR', weather='WEATHER_NONE', connections=None,
+            objects=[obj('OLD_WOMAN', 6, 4, f'{B}_OdetteHouse_EventScript_Odette', 'FLAG_ECHO_HIDE_ODETTE_HOME', 'MOVEMENT_TYPE_FACE_DOWN')],
+            warps=[warp(3, 8, 'MAP_VERRAN_BELLMOOR', 0), warp(4, 8, 'MAP_VERRAN_BELLMOOR', 0)], bg=[]),
+    B + '_TobinHouse': dict(id='MAP_VERRAN_BELLMOOR_TOBIN_HOUSE', layout='LAYOUT_HOUSE1', music='MUS_DEWFORD', mapsec='MAPSEC_BELLMOOR',
+            type='MAP_TYPE_INDOOR', weather='WEATHER_NONE', connections=None,
+            objects=[obj('FISHERMAN', 6, 4, f'{B}_TobinHouse_EventScript_Tobin', 'FLAG_ECHO_HIDE_TOBIN_HOME', 'MOVEMENT_TYPE_FACE_DOWN')],
+            warps=[warp(3, 8, 'MAP_VERRAN_BELLMOOR', 1), warp(4, 8, 'MAP_VERRAN_BELLMOOR', 1)], bg=[]),
+    B + '_BellHall': dict(id='MAP_VERRAN_BELLMOOR_BELL_HALL', layout='LAYOUT_LITTLEROOT_TOWN_PROFESSOR_BIRCHS_LAB', music='MUS_DEWFORD', mapsec='MAPSEC_BELLMOOR',
+            type='MAP_TYPE_INDOOR', weather='WEATHER_NONE', connections=None,
+            objects=[obj('OLD_WOMAN', 6, 5, f'{B}_BellHall_EventScript_Odette', 'FLAG_ECHO_HIDE_ODETTE_HALL', 'MOVEMENT_TYPE_FACE_UP'),
+                     obj('SCIENTIST_1', 9, 7, f'{B}_BellHall_EventScript_Archivist', move='MOVEMENT_TYPE_WANDER_AROUND')],
+            warps=[warp(6, 12, 'MAP_VERRAN_BELLMOOR', 2), warp(7, 12, 'MAP_VERRAN_BELLMOOR', 2)], bg=[]),
+}
+SECTIONS = [('MAPSEC_BELLMOOR', 'BELLMOOR'), ('MAPSEC_GLOAM_WOOD', 'GLOAM WOOD'), ('MAPSEC_TIDEWAY', 'TIDEWAY PATH')]
+
+for name, m in MAPS.items():
+    j = {'id': m['id'], 'name': name, 'layout': m['layout'], 'music': m['music'], 'region': 'REGION_HOENN',
+         'region_map_section': m['mapsec'], 'requires_flash': False, 'weather': m['weather'], 'map_type': m['type'],
+         'allow_cycling': m['type'] != 'MAP_TYPE_INDOOR', 'allow_escaping': False, 'allow_running': True,
+         'show_map_name': m['type'] != 'MAP_TYPE_INDOOR', 'battle_scene': 'MAP_BATTLE_SCENE_NORMAL',
+         'connections': m['connections'], 'object_events': m['objects'], 'warp_events': m['warps'],
+         'coord_events': [], 'bg_events': m['bg']}
+    os.makedirs(f'data/maps/{name}', exist_ok=True)
+    json.dump(j, open(f'data/maps/{name}/map.json', 'w'), indent=2)
+
+g = json.load(open('data/maps/map_groups.json'))
+if 'gMapGroup_Verran' not in g['group_order']:
+    g['group_order'].append('gMapGroup_Verran')
+g['gMapGroup_Verran'] = list(MAPS)
+json.dump(g, open('data/maps/map_groups.json', 'w'), indent=2)
+
+p = 'src/data/region_map/region_map_sections.json'
+r = json.load(open(p))
+have = {s['id'] for s in r['map_sections']}
+for sid, nm in SECTIONS:
+    if sid not in have:
+        r['map_sections'].append({'id': sid, 'name': nm, 'x': 0, 'y': 0, 'width': 1, 'height': 1})
+json.dump(r, open(p, 'w'), indent=2)
+print('ok', list(MAPS))
