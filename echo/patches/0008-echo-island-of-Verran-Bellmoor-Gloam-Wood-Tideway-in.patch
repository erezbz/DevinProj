+#!/usr/bin/env python3
+"""Pokémon Echo map kit: render tileset metatiles and map layouts to PNG (for authoring/preview)."""
+import struct, sys
+from PIL import Image
+
+def load_pal(path):
+    ln = open(path).read().split('\n')[3:19]
+    return [tuple(int(v) for v in l.split()) for l in ln]
+
+class Tileset:
+    def __init__(self, primary, secondary):
+        self.tiles = []
+        self.pals = [None] * 16
+        self.metas = []
+        for i, d in enumerate((primary, secondary)):
+            im = Image.open(d + '/tiles.png'); w, h = im.size; px = im.load()
+            tiles = []
+            for ty in range(h // 8):
+                for tx in range(w // 8):
+                    tiles.append([[px[tx * 8 + x, ty * 8 + y] & 15 for x in range(8)] for y in range(8)])
+            if i == 0: tiles = (tiles + [tiles[0]] * 512)[:512]
+            self.tiles += tiles
+            for p in range(16):
+                try:
+                    pal = load_pal(f'{d}/palettes/{p:02d}.pal')
+                except Exception: continue
+                if (i == 0 and p < 6) or (i == 1 and p >= 6): self.pals[p] = pal
+            m = open(d + '/metatiles.bin', 'rb').read()
+            metas = [struct.unpack_from('<8H', m, 16 * k) for k in range(len(m) // 16)]
+            if i == 0: metas = (metas + [metas[0]] * 512)[:512]
+            self.metas += metas
+
+    def meta_img(self, mid):
+        im = Image.new('RGB', (16, 16))
+        px = im.load()
+        for layer in range(2):
+            for q in range(4):
+                v = self.metas[mid][layer * 4 + q]
+                t = self.tiles[v & 0x3ff] if (v & 0x3ff) < len(self.tiles) else self.tiles[0]
+                pal = self.pals[v >> 12] or [(255, 0, 255)] * 16
+                for y in range(8):
+                    for x in range(8):
+                        sx = 7 - x if v & 0x400 else x; sy = 7 - y if v & 0x800 else y
+                        c = t[sy][sx]
+                        if layer == 0 or c:
+                            px[(q % 2) * 8 + x, (q // 2) * 8 + y] = pal[c]
+        return im
+
+def atlas(ts, start, count, cols=16, out='atlas.png'):
+    rows = (count + cols - 1) // cols
+    im = Image.new('RGB', (cols * 16, rows * 16))
+    for k in range(count):
+        if start + k < len(ts.metas): im.paste(ts.meta_img(start + k), ((k % cols) * 16, (k // cols) * 16))
+    im.resize((im.width * 2, im.height * 2), Image.NEAREST).save(out)
+
+def render_map(ts, binpath, w, h, out, scale=1):
+    d = open(binpath, 'rb').read(); cache = {}
+    im = Image.new('RGB', (w * 16, h * 16))
+    for y in range(h):
+        for x in range(w):
+            mid = struct.unpack_from('<H', d, 2 * (y * w + x))[0] & 0x3ff
+            if mid not in cache: cache[mid] = ts.meta_img(mid)
+            im.paste(cache[mid], (x * 16, y * 16))
+    if scale != 1: im = im.resize((im.width * scale, im.height * scale), Image.NEAREST)
+    im.save(out)
+
+if __name__ == '__main__':
+    ts = Tileset('data/tilesets/primary/general', 'data/tilesets/secondary/' + (sys.argv[2] if len(sys.argv) > 2 else 'petalburg'))
+    if sys.argv[1] == 'atlas':
+        atlas(ts, 0, 512, out='/home/ubuntu/rom/atlas_primary.png'); atlas(ts, 512, len(ts.metas) - 512, out='/home/ubuntu/rom/atlas_secondary.png')
+    else:
+        render_map(ts, sys.argv[1], int(sys.argv[3]), int(sys.argv[4]), sys.argv[5])
