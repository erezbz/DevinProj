--- /dev/null
+++ b/data/maps/VerranTideway/scripts.inc
@@ -0,0 +1,99 @@
+VerranTideway_MapScripts::
+	map_script MAP_SCRIPT_ON_TRANSITION, VerranTideway_OnTransition
+	.byte 0
+
+VerranTideway_OnTransition:
+	special EchoLoop_BufferDayTime
+	setflag FLAG_ECHO_HIDE_TOBIN_SHORE
+	setflag FLAG_ECHO_HIDE_COMPASS
+	setflag FLAG_ECHO_HIDE_TIDEPUP
+	call_if_ge VAR_0x8001, 2, VerranTideway_EventScript_ShowTobin
+	call_if_eq VAR_ECHO_PHASE, 4, VerranTideway_EventScript_TryCompass
+	call_if_unset FLAG_ECHO_TIDEPUP_DONE, VerranTideway_EventScript_TryTidepup
+	end
+
+VerranTideway_EventScript_ShowTobin::
+	clearflag FLAG_ECHO_HIDE_TOBIN_SHORE
+	return
+
+VerranTideway_EventScript_TryCompass::
+	goto_if_set FLAG_ECHO_HAS_COMPASS, VerranTideway_EventScript_Ret
+	goto_if_set FLAG_ECHO_GAVE_COMPASS, VerranTideway_EventScript_Ret
+	clearflag FLAG_ECHO_HIDE_COMPASS
+VerranTideway_EventScript_Ret:
+	return
+
+VerranTideway_EventScript_TryTidepup::
+	call_if_eq VAR_0x8001, 1, VerranTideway_EventScript_ShowTidepup
+	return
+
+VerranTideway_EventScript_ShowTidepup::
+	clearflag FLAG_ECHO_HIDE_TIDEPUP
+	return
+
+VerranTideway_EventScript_Tobin::
+	lock
+	faceplayer
+	goto_if_set FLAG_ECHO_HAS_COMPASS, VerranTideway_EventScript_TobinCompass
+	msgbox VerranTideway_Text_Tobin, MSGBOX_DEFAULT
+	setvar VAR_0x8004, 4
+	call EventScript_EchoNote
+	release
+	end
+
+VerranTideway_EventScript_TobinCompass::
+	msgbox VerranTideway_Text_TobinCompass, MSGBOX_DEFAULT
+	release
+	end
+
+VerranTideway_EventScript_Compass::
+	lock
+	playfanfare MUS_OBTAIN_ITEM
+	msgbox VerranTideway_Text_Compass, MSGBOX_DEFAULT
+	waitfanfare
+	setflag FLAG_ECHO_HAS_COMPASS
+	setflag FLAG_ECHO_HIDE_COMPASS
+	removeobject LOCALID_TIDEWAY_COMPASS
+	setvar VAR_0x8004, 5
+	call EventScript_EchoNote
+	release
+	end
+
+VerranTideway_EventScript_Tidepup::
+	lock
+	faceplayer
+	playmoncry SPECIES_TIDEPUP, CRY_MODE_ENCOUNTER
+	waitmoncry
+	setwildbattle SPECIES_TIDEPUP, 13
+	setflag FLAG_SYS_CTRL_OBJ_DELETE
+	dowildbattle
+	clearflag FLAG_SYS_CTRL_OBJ_DELETE
+	setflag FLAG_ECHO_TIDEPUP_DONE
+	setflag FLAG_ECHO_HIDE_TIDEPUP
+	removeobject LOCALID_TIDEWAY_TIDEPUP
+	release
+	end
+
+VerranTideway_EventScript_Sailor::
+	msgbox VerranTideway_Text_Sailor, MSGBOX_NPC
+	end
+
+VerranTideway_Text_Tobin:
+	.string "TOBIN: Tide's high. Nothing biting.\p"
+	.string "This season the low tide comes just\n"
+	.string "once: at dawn on the second day.\p"
+	.string "The shore gives back all sorts then.\n"
+	.string "Things the sea's kept for years.$"
+
+VerranTideway_Text_TobinCompass:
+	.string "TOBIN: That's… CORIN's compass!\n"
+	.string "Take it to Odette. Please.$"
+
+VerranTideway_Text_Compass:
+	.string "Half-buried in the wet sand: a\n"
+	.string "tarnished compass. Engraved: CORIN.$"
+
+VerranTideway_Text_Sailor:
+	.string "Ships keep sailing around this island\n"
+	.string "and somehow end up right back here.\p"
+	.string "Must be the fog. Or the bell.$"
