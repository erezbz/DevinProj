+	.string "Harder than ever before.\p"
+	.string "If only I knew he could hear…$"
+
 VerranGloamWood_Text_OdetteRing:
 	.string "ODETTE: Ring, bell… Bring him home!\n"
 	.string "CORIN, can you hear me?$"
@@ -171,3 +190,8 @@ VerranGloamWood_Text_Freed:
 	.string "a fourth morning dawns on Verran.\p"
 	.string "THE LOOP IS BROKEN.\n"
 	.string "Thanks for playing this slice!$"
+
+VerranGloamWood_Text_Ending:
+	.string "ODETTE: Listen… no bell. Just the sea.\p"
+	.string "Tomorrow will be a new day. A real one.\n"
+	.string "Thank you, child.$"
