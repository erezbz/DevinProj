+	goto_if_unset FLAG_ECHO_LOOP_ACTIVE, VerranGloamWood_EventScript_Ending
 	goto_if_set FLAG_ECHO_GAVE_COMPASS, VerranGloamWood_EventScript_Farewell
+	goto_if_lt VAR_ECHO_PHASE, 11, VerranGloamWood_EventScript_OdetteWaits
