+	setvar VAR_0x8004, 2
+	call EventScript_EchoNote
+	release
+	end
+
+VerranGloamWood_EventScript_Ending::
+	msgbox VerranGloamWood_Text_Ending, MSGBOX_DEFAULT
+	release
+	end
+
