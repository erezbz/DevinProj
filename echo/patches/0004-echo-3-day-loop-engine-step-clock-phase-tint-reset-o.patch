--- /dev/null
+++ b/data/scripts/echo.inc
@@ -0,0 +1,40 @@
+EventScript_EchoPhaseChange::
+	lockall
+	special EchoLoop_BufferPhase
+	playse SE_DING_DONG
+	msgbox EchoText_PhaseChange, MSGBOX_DEFAULT
+	releaseall
+	end
+
+EventScript_EchoLoopEnd::
+	lockall
+	playse SE_ORB
+	msgbox EchoText_LoopEnd, MSGBOX_DEFAULT
+	fadescreen FADE_TO_WHITE
+	special EchoLoop_EndLoop
+	waitstate
+	end
+
+EventScript_EchoWake::
+	lockall
+	delay 30
+	special EchoLoop_BufferPhase
+	msgbox EchoText_Wake, MSGBOX_DEFAULT
+	releaseall
+	end
+
+EventScript_EchoJournal::
+	lockall
+	special EchoJournal_Buffer
+	msgbox gStringVar4, MSGBOX_DEFAULT
+	releaseall
+	end
+
+EchoText_PhaseChange:
+	.string "A distant bell tolls.\n{STR_VAR_1}, {STR_VAR_2}.$"
+
+EchoText_LoopEnd:
+	.string "The bell tolls a final time…\pThe sky tears open into white light.$"
+
+EchoText_Wake:
+	.string "…You wake with a start.\n{STR_VAR_1}, {STR_VAR_2}. Again.\pLoop {STR_VAR_3}.\nYou remember everything.$"
