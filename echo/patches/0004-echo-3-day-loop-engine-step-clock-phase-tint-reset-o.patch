+// Pokémon Echo: the island relives the same three days. Phases advance with steps
+// (not the real-time clock); at the end of day 3 or on a blackout the world resets.
+// Kept across loops: party slot 1 (your bonded partner), journal flags, Echo Shards.
+
+static EWRAM_DATA bool8 sWakePending = FALSE;
+
+static const u8 *const sPhaseNames[ECHO_PHASES_PER_DAY] =
+{
+    COMPOUND_STRING("Dawn"),
+    COMPOUND_STRING("Day"),
+    COMPOUND_STRING("Dusk"),
+    COMPOUND_STRING("Night"),
+};
+
+static const u8 sPhaseHours[ECHO_PHASES_PER_DAY] = {6, 12, 18, 22};
+
+static const u8 *const sJournalEntries[ECHO_JOURNAL_COUNT] =
+{
+    COMPOUND_STRING("The bell tolls at every change of\nlight. After three days, it breaks."),
+    COMPOUND_STRING("Wake. Remember. Change something.\nThe island forgets. I don't."),
+};
+
+bool32 EchoLoop_IsActive(void)
+{
+    return FlagGet(FLAG_ECHO_LOOP_ACTIVE);
+}
+
+u32 EchoLoop_GetHours(void)
+{
+    return sPhaseHours[VarGet(VAR_ECHO_PHASE) % ECHO_PHASES_PER_DAY];
+}
+
+bool32 EchoLoop_OnStep(void)
+{
+    u32 steps, phase;
+
+    if (!EchoLoop_IsActive())
+        return FALSE;
+    steps = VarGet(VAR_ECHO_STEPS) + 1;
+    if (steps < ECHO_STEPS_PER_PHASE)
+    {
+        VarSet(VAR_ECHO_STEPS, steps);
+        return FALSE;
+    }
+    VarSet(VAR_ECHO_STEPS, 0);
+    phase = VarGet(VAR_ECHO_PHASE) + 1;
+    if (phase >= ECHO_TOTAL_PHASES)
+    {
+        ScriptContext_SetupScript(EventScript_EchoLoopEnd);
+        return TRUE;
+    }
+    VarSet(VAR_ECHO_PHASE, phase);
+    SetTimeOfDay(EchoLoop_GetHours());
+    ScriptContext_SetupScript(EventScript_EchoPhaseChange);
+    return TRUE;
+}
+
+void EchoLoop_Begin(void)
+{
+    FlagSet(FLAG_ECHO_LOOP_ACTIVE);
+    VarSet(VAR_ECHO_LOOP, 1);
+    VarSet(VAR_ECHO_PHASE, 0);
+    VarSet(VAR_ECHO_STEPS, 0);
+    FlagSet(FLAG_ECHO_JOURNAL_START);
+}
+
+void EchoLoop_BufferPhase(void)
+{
+    u32 phase = VarGet(VAR_ECHO_PHASE);
+    u8 *end = StringCopy(gStringVar1, COMPOUND_STRING("Day "));
+    ConvertIntToDecimalStringN(end, phase / ECHO_PHASES_PER_DAY + 1, STR_CONV_MODE_LEFT_ALIGN, 1);
+    StringCopy(gStringVar2, sPhaseNames[phase % ECHO_PHASES_PER_DAY]);
+    ConvertIntToDecimalStringN(gStringVar3, VarGet(VAR_ECHO_LOOP), STR_CONV_MODE_LEFT_ALIGN, 4);
+}
+
+static void ResetWorld(void)
+{
+    u16 loop = VarGet(VAR_ECHO_LOOP);
+    u16 shards = VarGet(VAR_ECHO_SHARDS);
+    bool8 journal[ECHO_JOURNAL_COUNT];
+    struct Pokemon partner = gPlayerParty[0];
+    u32 i;
+
+    for (i = 0; i < ECHO_JOURNAL_COUNT; i++)
+        journal[i] = FlagGet(FLAG_ECHO_JOURNAL_START + i);
+
+    // Story and trainer flags reset; system flags (badges, menus) survive.
+    memset(gSaveBlock1Ptr->flags, 0, SYSTEM_FLAGS / 8);
+    memset(gSaveBlock1Ptr->vars, 0, sizeof(gSaveBlock1Ptr->vars));
+
+    for (i = 0; i < ECHO_JOURNAL_COUNT; i++)
+    {
+        if (journal[i])
+            FlagSet(FLAG_ECHO_JOURNAL_START + i);
+    }
+    FlagSet(FLAG_ECHO_LOOP_ACTIVE);
+    VarSet(VAR_ECHO_LOOP, loop + 1);
+    VarSet(VAR_ECHO_SHARDS, shards);
+
+    ZeroPlayerPartyMons();
+    gPlayerParty[0] = partner;
+    CalculatePlayerPartyCount();
+    HealPlayerParty();
+    ClearBag();
+    SetMoney(&gSaveBlock1Ptr->money, ECHO_LOOP_START_MONEY);
+}
+
+static void SetLoopStartWarp(void)
+{
+    SetWarpDestination(MAP_GROUP(ECHO_LOOP_START_MAP), MAP_NUM(ECHO_LOOP_START_MAP), WARP_ID_NONE, ECHO_LOOP_START_X, ECHO_LOOP_START_Y);
+}
+
+static void FieldCB_EchoWake(void)
+{
+    LockPlayerFieldControls();
+    FadeInFromBlack();
+    ScriptContext_SetupScript(EventScript_EchoWake);
+}
+
+void EchoLoop_EndLoop(void)
+{
+    ResetWorld();
+    SetLoopStartWarp();
+    DoWarp();
+    ResetInitialPlayerAvatarState();
+    gFieldCallback = FieldCB_EchoWake;
+}
+
+bool32 EchoLoop_OnWhiteOut(void)
+{
+    if (!EchoLoop_IsActive())
+        return FALSE;
+    ResetWorld();
+    SetLoopStartWarp();
+    sWakePending = TRUE;
+    return TRUE;
+}
+
+void EchoLoop_OverrideWhiteOutFieldCallback(void)
+{
+    if (sWakePending)
+    {
+        sWakePending = FALSE;
+        gFieldCallback = FieldCB_EchoWake;
+    }
+}
+
+// special: gSpecialVar_0x8004 = journal entry index
+void EchoJournal_Unlock(void)
+{
+    if (gSpecialVar_0x8004 < ECHO_JOURNAL_COUNT)
+        FlagSet(FLAG_ECHO_JOURNAL_START + gSpecialVar_0x8004);
+}
+
+void EchoJournal_Buffer(void)
+{
+    u32 i;
+    u8 *s = gStringVar4;
+
+    EchoLoop_BufferPhase();
+    s = StringCopy(s, COMPOUND_STRING("ECHO JOURNAL - Loop "));
+    s = StringCopy(s, gStringVar3);
+    s = StringCopy(s, COMPOUND_STRING("\n"));
+    s = StringCopy(s, gStringVar1);
+    s = StringCopy(s, COMPOUND_STRING(", "));
+    s = StringCopy(s, gStringVar2);
+    s = StringCopy(s, COMPOUND_STRING(" - Shards: "));
+    s = ConvertIntToDecimalStringN(s, VarGet(VAR_ECHO_SHARDS), STR_CONV_MODE_LEFT_ALIGN, 3);
+    for (i = 0; i < ECHO_JOURNAL_COUNT; i++)
+    {
+        if (!FlagGet(FLAG_ECHO_JOURNAL_START + i) || sJournalEntries[i] == NULL)
+            continue;
+        s = StringCopy(s, COMPOUND_STRING("\p"));
+        s = StringCopy(s, sJournalEntries[i]);
+    }
+}
